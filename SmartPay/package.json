{
  "name": "SmartPay",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "private": true,
  "cds": {
    "requires": {
      "auth": {
        "kind": "mocked",
        "users": {
          "buyer":    { "password": "buyer",    "roles": ["Buyer"] },
          "ap":       { "password": "ap",       "roles": ["AP_Lead"] },
          "admin":    { "password": "admin",    "roles": ["Admin"] },
          "supplier": { "password": "supplier", "roles": ["Supplier"] },
          "system":   { "password": "system",   "roles": ["system-service"] }
        }
      },
      "[production]": {
        "auth": "xsuaa"
      },
      "messaging": {
        "kind": "enterprise-messaging"
      },
      "connectivity": true,
      "destinations": true,
      "html5-repo": true
    }
  }
}